#!/usr/bin/env python3
"""portal — animated Rick and Morty interdimensional portal for your terminal.

Controls: q or Ctrl-C to quit.
"""
from __future__ import annotations

import math
import os
import select
import shutil
import signal
import sys
import termios
import time
import tty

GREENS = [
    (10, 70, 30),
    (30, 130, 50),
    (70, 200, 90),
    (140, 255, 150),
    (210, 255, 220),
    (240, 255, 245),
]
CHARS = " .,:;!=*o#%&@"

ASPECT_Y = 2.0


def write(s: str) -> None:
    sys.stdout.write(s)


def main() -> None:
    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    old_attrs = termios.tcgetattr(fd) if fd is not None else None

    def restore() -> None:
        # Leave the alternate screen, restoring the user's terminal contents.
        write("\x1b[0m\x1b[?25h\x1b[2J\x1b[H\x1b[?1049l")
        sys.stdout.flush()
        if fd is not None and old_attrs is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)

    def on_signal(*_):
        restore()
        sys.exit(0)

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    if fd is not None:
        tty.setcbreak(fd)
    # Enter the alternate screen buffer so the animation doesn't clobber scrollback.
    write("\x1b[?1049h\x1b[?25l\x1b[2J")
    sys.stdout.flush()

    t0 = time.time()
    target_dt = 1 / 30
    try:
        while True:
            frame_start = time.time()
            if fd is not None:
                r, _, _ = select.select([fd], [], [], 0)
                if r:
                    ch = os.read(fd, 16)
                    if b"q" in ch or b"\x1b" in ch:
                        break

            cols, rows = shutil.get_terminal_size((80, 24))
            cx, cy = cols / 2 - 0.5, rows / 2 - 0.5
            max_r = min(cx, cy * ASPECT_Y) * 0.95
            if max_r <= 1:
                time.sleep(0.1)
                continue
            t = time.time() - t0

            out = ["\x1b[H"]
            prev_col = None
            for y in range(rows):
                dy = (y - cy) * ASPECT_Y
                for x in range(cols):
                    dx = x - cx
                    r = math.hypot(dx, dy)
                    rn = r / max_r
                    if rn > 1.18:
                        if prev_col is not None:
                            out.append("\x1b[0m")
                            prev_col = None
                        out.append(" ")
                        continue
                    theta = math.atan2(dy, dx)
                    swirl = (
                        math.sin(3 * theta + 7 * rn - t * 3.5)
                        + 0.55 * math.sin(5 * theta - 4 * rn + t * 2.3)
                        + 0.35 * math.sin(2 * theta + 11 * rn - t * 1.7)
                    )
                    swirl = (swirl + 1.9) / 3.8
                    core = math.exp(-rn * rn * 1.8)
                    intensity = swirl * 0.55 + core * 0.45
                    ring = math.exp(-((rn - 0.98) ** 2) * 90) * 0.9
                    intensity = max(intensity, ring)
                    if rn > 1.0:
                        intensity *= max(0.0, 1 - (rn - 1.0) * 5.5)
                    intensity = max(0.0, min(1.0, intensity))
                    ci = int(intensity * (len(CHARS) - 1))
                    char = CHARS[ci]
                    if char == " ":
                        if prev_col is not None:
                            out.append("\x1b[0m")
                            prev_col = None
                        out.append(" ")
                        continue
                    col = GREENS[min(len(GREENS) - 1, int(intensity * len(GREENS)))]
                    if col != prev_col:
                        out.append(f"\x1b[38;2;{col[0]};{col[1]};{col[2]}m")
                        prev_col = col
                    out.append(char)
                if prev_col is not None:
                    out.append("\x1b[0m")
                    prev_col = None
                if y < rows - 1:
                    out.append("\n")
            write("".join(out))
            sys.stdout.flush()

            elapsed = time.time() - frame_start
            if elapsed < target_dt:
                time.sleep(target_dt - elapsed)
    finally:
        restore()


if __name__ == "__main__":
    main()
