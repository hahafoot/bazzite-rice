#!/usr/bin/env python3
"""cube — spinning wireframe ASCII cube. q/Esc/Ctrl-C to quit."""
from __future__ import annotations

import math
import os
import select
import shutil
import signal
import sys
import termios
import time
import tty

DEPTH_RAMP = [
    (10, 30, 60),
    (25, 80, 140),
    (50, 150, 210),
    (110, 210, 245),
    (190, 240, 255),
    (245, 252, 255),
]
DEPTH_CHARS = ".,:;=*o#&@"

ASPECT_Y = 2.0
K1 = 4.0

S = 1.0
V = [
    (-S, -S, -S), (S, -S, -S), (S, S, -S), (-S, S, -S),  # back face (z=-1)
    (-S, -S,  S), (S, -S,  S), (S, S,  S), (-S, S,  S),  # front face (z=+1)
]
EDGES = [
    (0, 1), (1, 2), (2, 3), (3, 0),  # back square
    (4, 5), (5, 6), (6, 7), (7, 4),  # front square
    (0, 4), (1, 5), (2, 6), (3, 7),  # connectors
]


def rot(p, ax, ay, az):
    x, y, z = p
    ca, sa = math.cos(ax), math.sin(ax)
    y, z = y * ca - z * sa, y * sa + z * ca
    cb, sb = math.cos(ay), math.sin(ay)
    x, z = x * cb + z * sb, -x * sb + z * cb
    cc, sc = math.cos(az), math.sin(az)
    x, y = x * cc - y * sc, x * sc + y * cc
    return x, y, z


def write(s):
    sys.stdout.write(s)


def main():
    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    old = termios.tcgetattr(fd) if fd is not None else None

    def restore():
        # Leave the alternate screen, restoring the user's terminal contents.
        write("\x1b[0m\x1b[?25h\x1b[2J\x1b[H\x1b[?1049l")
        sys.stdout.flush()
        if fd is not None and old is not None:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)

    def on_sig(*_):
        restore()
        sys.exit(0)

    signal.signal(signal.SIGINT, on_sig)
    signal.signal(signal.SIGTERM, on_sig)
    if fd is not None:
        tty.setcbreak(fd)
    # Enter the alternate screen buffer so the cube doesn't clobber scrollback.
    write("\x1b[?1049h\x1b[?25l\x1b[2J")
    sys.stdout.flush()

    t0 = time.time()
    target_dt = 1 / 30
    try:
        while True:
            frame_start = time.time()
            if fd is not None:
                r, _, _ = select.select([fd], [], [], 0)
                if r:
                    ch = os.read(fd, 16)
                    if b"q" in ch or b"\x1b" in ch:
                        break

            cols, rows = shutil.get_terminal_size((80, 24))
            cx, cy = cols / 2, rows / 2
            # Fit cube of half-side 1 with some padding. Account for char aspect.
            scale = min(cols / ASPECT_Y, rows) * 0.42 * ASPECT_Y
            scale_x = scale
            scale_y = scale / ASPECT_Y

            t = time.time() - t0
            ax, ay, az = t * 0.6, t * 0.9, t * 0.4

            # Rotate + project all 8 vertices once.
            projected = []
            for vx, vy, vz in V:
                rx, ry, rz = rot((vx, vy, vz), ax, ay, az)
                depth = rz + K1
                ooz = 1.0 / depth
                sx = cx + scale_x * rx * ooz
                sy = cy - scale_y * ry * ooz
                projected.append((sx, sy, depth))

            char_buf = [[None] * cols for _ in range(rows)]
            color_buf = [[None] * cols for _ in range(rows)]
            zbuf = [[1e9] * cols for _ in range(rows)]

            # Depth range for shading
            min_d = min(p[2] for p in projected)
            max_d = max(p[2] for p in projected)
            d_span = max(0.01, max_d - min_d)

            for a, b in EDGES:
                x0, y0, d0 = projected[a]
                x1, y1, d1 = projected[b]
                dx = x1 - x0
                dy = y1 - y0
                steps = int(max(abs(dx), abs(dy)) * 1.5) + 1
                for i in range(steps + 1):
                    t_ = i / steps
                    px = x0 + dx * t_
                    py = y0 + dy * t_
                    pd = d0 + (d1 - d0) * t_
                    ix, iy = int(round(px)), int(round(py))
                    if 0 <= ix < cols and 0 <= iy < rows and pd < zbuf[iy][ix]:
                        # closer = brighter
                        norm = 1.0 - (pd - min_d) / d_span
                        ci = int(norm * (len(DEPTH_CHARS) - 1))
                        col_i = int(norm * (len(DEPTH_RAMP) - 1))
                        zbuf[iy][ix] = pd
                        char_buf[iy][ix] = DEPTH_CHARS[ci]
                        color_buf[iy][ix] = DEPTH_RAMP[col_i]

            out = ["\x1b[H"]
            prev_col = None
            for y in range(rows):
                line = []
                for x in range(cols):
                    ch = char_buf[y][x]
                    if ch is None:
                        if prev_col is not None:
                            line.append("\x1b[0m")
                            prev_col = None
                        line.append(" ")
                        continue
                    col = color_buf[y][x]
                    if col != prev_col:
                        line.append(f"\x1b[38;2;{col[0]};{col[1]};{col[2]}m")
                        prev_col = col
                    line.append(ch)
                if prev_col is not None:
                    line.append("\x1b[0m")
                    prev_col = None
                if y < rows - 1:
                    line.append("\n")
                out.append("".join(line))
            write("".join(out))
            sys.stdout.flush()

            elapsed = time.time() - frame_start
            if elapsed < target_dt:
                time.sleep(target_dt - elapsed)
    finally:
        restore()


if __name__ == "__main__":
    main()
